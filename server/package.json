{
  "name": "straycare-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Stray Reporting & Rescue System (Fluxatic Global, Panjim - Goa internship project)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
