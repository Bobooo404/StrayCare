# Copy this file to `.env` and adjust the values.

NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/straycare

# Secrets - generate your own with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Auth cookie name
COOKIE_NAME=straycare_token

# Set to 1 when deploying behind HTTPS so the cookie is only sent over TLS
COOKIE_SECURE=0

# `lax` while the client and the API share an origin.
# When the client is on Netlify and the API is on another host, set BOTH:
#   COOKIE_SAME_SITE=none
#   COOKIE_SECURE=1
# Anything other than `none` and the browser will not send the cookie with the
# API calls, so every request comes back logged out.
COOKIE_SAME_SITE=lax

# Comma separated list of origins allowed to call the API with credentials.
# In production this must include the Netlify URL, e.g.
#   CLIENT_ORIGIN=https://straycare.netlify.app
CLIENT_ORIGIN=http://localhost:5173

# Public origin of this API, e.g. https://straycare-api.onrender.com
# Used to build absolute URLs for uploaded photos. Leave empty when the client
# and the API are served from the same host.
PUBLIC_URL=

# AI triage (Google Gemini). Server side only, never exposed to the browser.
# Get a key at https://aistudio.google.com/apikey
# Never commit a real key: keep it in .env, which is gitignored.
GEMINI_API_KEY=
# Must be a vision capable model that is still callable by your key. Check with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models" -H "x-goog-api-key: $GEMINI_API_KEY"
GEMINI_MODEL=gemini-3.8-flash

# Nearby vet clinics, via the free OpenStreetMap Overpass API (no key needed)
OVERPASS_URL=https://overpass-api.de/api/interpreter
